# Copier vers .env — ne jamais committer .env
CONTACT_EMAIL=
DRY_RUN=true

POSTGRES_USER=veille
POSTGRES_PASSWORD=change-me
VEILLE_DB_URL=postgresql+psycopg://veille:change-me@postgres:5432/veille

# Sources
RELIEFWEB_APPNAME=
FT_CLIENT_ID=
FT_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GMAIL_TOKEN_FILE=/app/credentials/gmail_token.json

# E-mail (dev : Mailpit sans authentification ; prod : SMTP du fournisseur, STARTTLS si SMTP_USER)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=

# Embeddings (CPU) : modèle sentence-transformers, ou « fake » pour un essai sans téléchargement
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Discord (optionnel) : webhook du salon (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=

# Interface : lien ajouté au rapport (e-mail et Discord), ex. https://stagiaire.mondomaine.fr/
INTERFACE_URL=

# Production (docker-compose.prod.yml, voir docs/deploiement.md)
# true en prod : démarre les planifications Dagster (arrêtées en dev)
SCHEDULES_RUNNING=false
# nom de domaine de l'interface et adresse pour les avis d'expiration des certificats
DOMAIN=
LETSENCRYPT_EMAIL=
# mot de passe long et aléatoire, sans « $ » (ex. openssl rand -base64 24)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Candidatures : adresse d'expédition des brouillons Gmail (doit être celle du jeton Gmail)
CANDIDATURES_FROM=
