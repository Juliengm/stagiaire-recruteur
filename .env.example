# Copier vers .env — ne jamais committer .env
CONTACT_EMAIL=
DRY_RUN=true

POSTGRES_USER=veille
POSTGRES_PASSWORD=change-me
VEILLE_DB_URL=postgresql+psycopg://veille:change-me@postgres:5432/veille

# Sources (voir SOURCES.md §7)
RELIEFWEB_APPNAME=
FT_CLIENT_ID=
FT_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GMAIL_TOKEN_FILE=/app/credentials/gmail_token.json

# E-mail (dev : Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
DIGEST_TO=

# Embeddings (CPU) : modèle sentence-transformers, ou « fake » pour un essai sans téléchargement
EMBEDDING_MODEL=intfloat/multilingual-e5-base
